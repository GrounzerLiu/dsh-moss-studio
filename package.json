{
  "name": "dsh-moss-studio",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "MOSS-Image studio: a sidebar workbench for local ComfyUI layout generation, with history and AI-readable drafts.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "workflow",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "engines": {
      "dsh": ">=0.1.0"
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@tanstack/react-virtual": "^3.14.28",
    "react-zoom-pan-pinch": "^4.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.20.0-alpha.1"
  }
}
